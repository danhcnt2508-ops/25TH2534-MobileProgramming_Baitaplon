<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPracticeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F7FA">

    <!--Phần hiển thị tiến độ làm bài-->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiến độ: 1/30"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvProgress">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Nội dung câu hỏi luyện tập?"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>
    </com.google.android.material.card.MaterialCardView>

    <!--Thêm 4 nút lựa chọn đáp án RadioButton-->
    <RadioGroup
        android:id="@+id/rgOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/cardQuestion">

        <RadioButton
            android:id="@+id/rbOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:textSize="16sp"/>
        <RadioButton
            android:id="@+id/rbOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:textSize="16sp"/>
        <RadioButton
            android:id="@+id/rbOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:textSize="16sp"/>
        <RadioButton
            android:id="@+id/rbOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:textSize="16sp"/>
    </RadioGroup>

    <!--Khu vực nút bấm điều hướng: Kiểm tra đáp án/Hoàn thành bài luyện tập-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp">

        <!--nút kiểm tra-->
        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Kiểm tra áp án"
            android:textSize="16sp"
            android:backgroundTint="#00796B"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!--nút hoàn thành-->
        <Button
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Hoàn thành bài luyện tập"
            android:textSize="16sp"
            android:backgroundTint="#D32F2F"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>